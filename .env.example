XRPL_RPC_URL=https://s.altnet.rippletest.net:51234/
XRPL_EXPLORER_URL=https://testnet.xrpl.org
X402_FACILITATOR_URL=https://xrpl-facilitator-testnet.t54.ai
X402_NETWORK=xrpl:1
MERCHANT_BASE_URL=http://127.0.0.1:8000
GUARD_DB_PATH=data/agentguard.db

TREASURY_ADDRESS=
TREASURY_SEED=

AGENT_ADDRESS=
AGENT_SEED=

ISSUER_ADDRESS=
ISSUER_SEED=

MERCHANT_A_ADDRESS=
MERCHANT_A_SEED=

MERCHANT_B_ADDRESS=
MERCHANT_B_SEED=

MERCHANT_C_ADDRESS=
MERCHANT_C_SEED=

# agent 模型配置（agent/agent.py 只读取这几个键）
AGENT_MODEL_PROVIDER=anthropic
AGENT_MODEL_ID=claude-opus-5-5
ANTHROPIC_API_KEY=
# 切到 Bedrock：AGENT_MODEL_PROVIDER=bedrock，并设置下面两项（AWS 凭证走标准 boto3 链）
BEDROCK_MODEL_ID=anthropic.claude-opus-5-5
AWS_REGION=us-east-1

GUARD_API_URL=http://127.0.0.1:8100

# true 时开放 POST /api/demo/reset（清空本地审计/预算/审批，重置商户 D）
DEMO_MODE=false
# MCP server 用的 agent 身份（幂等键是 agent_id + request_id）
AGENT_ID=demo-agent

# 金库审批付款的签名方式：speculos | software
SIGNER_MODE=software
SPECULOS_URL=http://127.0.0.1:5001
SPECULOS_MODEL=STAX
# 由 scripts/lock_treasury.py 写入
TREASURY_SIGNER_ADDRESS=
TREASURY_SIGNER_PUBLIC_KEY=
